# DeployWatch Environment Variables
# Copy this file to .env and fill in the values

# ─── Database ──────────────────────────────────────────────
POSTGRES_USER=deploywatch
POSTGRES_PASSWORD=deploywatch_secret
POSTGRES_DB=deploywatch
DATABASE_URL=postgresql://deploywatch:deploywatch_secret@localhost:5432/deploywatch

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── API ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ─── GitHub Integration ─────────────────────────────────────
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# ─── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_change_in_production

# ─── Notifications ─────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@deploywatch.local

SLACK_BOT_TOKEN=

# ─── Health Check Scheduler ────────────────────────────────
HEALTH_CHECK_CONCURRENCY=10
HEALTH_CHECK_DEFAULT_INTERVAL=60
HEALTH_CHECK_DEFAULT_TIMEOUT=5000

# ─── Data Retention (days) ─────────────────────────────────
HEALTH_CHECK_RETENTION_DAYS=30
WEBHOOK_EVENT_RETENTION_DAYS=90
